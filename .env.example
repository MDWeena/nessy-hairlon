# Supabase — client (exposed to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-only (used only in Vercel serverless functions, e.g. api/send-notification.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — client-side unsigned uploads (exposed to the browser)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Resend — server-only, used in api/send-notification.ts and api/process-reminders.ts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional — if set, api/process-reminders.ts requires this as a Bearer token
# (protects the cron endpoint from being triggered by outsiders). Vercel
# automatically sends this value as the Authorization header on its own cron
# invocations once it's set as an env var on the project — no extra config.
CRON_SECRET=

# Vercel — used by deployment tooling, not read by the app itself
VERCEL_TOKEN=
